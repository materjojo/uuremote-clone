<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>UURemoteClone</AssemblyName>
    <RootNamespace>UURemoteClone</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.17" />
    <PackageReference Include="Google.Protobuf" Version="3.25.3" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Update="gvpb.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\native\official\runtime\windows\streamer.dll" Link="streamer.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\native\official\runtime\windows\streamer-config.json" Link="streamer-config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\gv_pb\*.proto" ProtoRoot="..\..\proto\gv_pb" GrpcServices="None" />
  </ItemGroup>
  <Target Name="PackageIndependentVideoRuntime" AfterTargets="Publish" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/DownloadFFmpeg.ps1&quot; -OutputDirectory &quot;$(PublishDir)ffmpeg&quot;" />
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../Tests/WindowsPeerSmoke&quot; -c Release -- &quot;$(PublishDir)ffmpeg&quot;" />
  </Target>
</Project>
