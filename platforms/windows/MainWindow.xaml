<Window x:Class="UURemoteClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UURemoteClone"
        Title="UU远程" Height="720" Width="1100" MinHeight="620" MinWidth="960"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#E8EAED" BorderThickness="0,0,1,0">
            <StackPanel>
                <Image Source="Assets/brand.png" Width="151" Height="28" Margin="20,24,20,30"/>
                <Button x:Name="NavDevices" Foreground="{StaticResource Accent}" Background="Transparent"
                        BorderThickness="0" Padding="20,12" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="devices">
                    <StackPanel Orientation="Horizontal"><Image Source="Assets/devices.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="我的设备" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="NavFiles" Foreground="{StaticResource Muted}" Background="Transparent"
                        BorderThickness="0" Padding="20,12" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="files">
                    <StackPanel Orientation="Horizontal"><Image Source="Assets/files.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="文件传输" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="NavTerminal" Foreground="{StaticResource Muted}" Background="Transparent"
                        BorderThickness="0" Padding="20,12" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="terminal">
                    <StackPanel Orientation="Horizontal"><Image Source="Assets/terminal.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="终端" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="NavSettings" Foreground="{StaticResource Muted}" Background="Transparent"
                        BorderThickness="0" Padding="20,12" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="settings">
                    <StackPanel Orientation="Horizontal"><Image Source="Assets/settings.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1" x:Name="DeviceView" Margin="28,26">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <DockPanel Margin="0,0,0,22">
                    <Button Content="＋ 添加设备" DockPanel.Dock="Right" Click="AddDevice_Click" Style="{StaticResource PrimaryButton}"/>
                    <TextBlock Text="我的设备" FontSize="22" FontWeight="SemiBold"/>
                </DockPanel>
                <Border Background="{StaticResource Card}" BorderBrush="#E8EAED" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="ReceiveButton" Content="开启接收" DockPanel.Dock="Right" Click="Receive_Click" Style="{StaticResource PrimaryButton}"/>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/assist.png" Width="22" Height="22" Margin="0,0,8,0"/>
                                <TextBlock Text="接收远程连接" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox x:Name="ServerBox" Margin="0,14,0,10" Padding="8,6"
                                 ToolTip="自建信令服务根地址，例如 https://signal.example.org 或 http://局域网地址:8080"/>
                        <DockPanel>
                            <Button x:Name="CopyCodeButton" Content="复制本机配对码" IsEnabled="False" Click="CopyCode_Click" DockPanel.Dock="Right" Padding="10,5"/>
                            <TextBlock x:Name="HostStatus" Text="输入自建服务地址后开启接收，每次连接需本机确认"
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="EmptyState" Text="还没有添加设备。请在另一台设备开启接收，再粘贴其配对码添加。"
                           Foreground="{StaticResource Muted}" FontSize="14" Margin="0,32,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="PagePlaceholder" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                       FontSize="14" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Card}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10" BorderBrush="#E8EAED" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Image Width="40" Height="40" HorizontalAlignment="Left">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="Assets/windows.png"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Platform}" Value="mac"><Setter Property="Source" Value="Assets/mac.png"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Platform}" Value="android"><Setter Property="Source" Value="Assets/android.png"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15"/>
                                    <TextBlock Text="已配对" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="远程控制" Style="{StaticResource PrimaryButton}" Click="Connect_Click" Tag="{Binding Id}"/>
                                    <Button Content="移除" Foreground="{StaticResource Muted}" Background="Transparent" Margin="10,0,0,0"
                                            BorderThickness="0" Click="RemoveDevice_Click" Tag="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="1" x:Name="RemoteView" Visibility="Collapsed" Background="Black">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#202226" Padding="8,6" Margin="8,8,8,0" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="显示屏" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="全屏" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4" Click="FullScreen_Click"/>
                    <Button Content="窗口设置" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="画质" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="鼠标" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="键盘" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4" Click="SendText_Click"/>
                    <Button Content="文件传输" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="断开" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0" Padding="10,4" Click="Disconnect_Click"/>
                </StackPanel>
            </Border>
            <local:RemoteVideoControl x:Name="VideoCanvas" Grid.Row="1" Margin="8"
                                     MouseLeftButtonDown="Video_MouseDown" MouseLeftButtonUp="Video_MouseUp" MouseMove="Video_MouseMove"/>
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="未连接" Foreground="#CDD1D8" Margin="12,2,12,8" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
