<Window x:Class="UURemoteClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UURemoteClone"
        Title="UU远程" Height="720" Width="1100"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <StackPanel Grid.Column="0" Background="#0E0F11">
            <TextBlock Text="网易UU远程" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       Margin="20,22,20,26"/>
            <Button x:Name="NavDevices" Content="设备" Foreground="{StaticResource Accent}"
                    Background="Transparent" BorderThickness="0" Padding="20,6" HorizontalContentAlignment="Left"
                    Click="Nav_Click" Tag="devices"/>
            <Button x:Name="NavFiles" Content="文件传输" Foreground="{StaticResource Muted}"
                    Background="Transparent" BorderThickness="0" Padding="20,6" HorizontalContentAlignment="Left"
                    Click="Nav_Click" Tag="files"/>
            <Button x:Name="NavTerminal" Content="终端" Foreground="{StaticResource Muted}"
                    Background="Transparent" BorderThickness="0" Padding="20,6" HorizontalContentAlignment="Left"
                    Click="Nav_Click" Tag="terminal"/>
            <Button x:Name="NavSettings" Content="设置" Foreground="{StaticResource Muted}"
                    Background="Transparent" BorderThickness="0" Padding="20,6" HorizontalContentAlignment="Left"
                    Click="Nav_Click" Tag="settings"/>
        </StackPanel>

        <!-- 设备视图 -->
        <DockPanel Grid.Column="1" x:Name="DeviceView" Margin="24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <DockPanel Margin="0,0,0,18">
                    <Button Content="＋ 添加设备" DockPanel.Dock="Right" Click="AddDevice_Click" Padding="12,7"/>
                    <TextBlock Text="我的设备" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                </DockPanel>
                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="ReceiveButton" Content="开启接收" DockPanel.Dock="Right" Click="Receive_Click" Padding="12,5"/>
                            <TextBlock Text="接收远程连接" Foreground="White" FontSize="15"/>
                        </DockPanel>
                        <TextBox x:Name="ServerBox" Margin="0,12,0,8" ToolTip="自建信令服务根地址，例如 https://signal.example.org 或 http://局域网地址:8080"/>
                        <DockPanel>
                            <Button x:Name="CopyCodeButton" Content="复制本机配对码" IsEnabled="False" Click="CopyCode_Click" DockPanel.Dock="Right"/>
                            <TextBlock x:Name="HostStatus" Text="输入自建服务地址后开启接收，每次连接需本机确认" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="EmptyState" Text="还没有添加设备。请在另一台设备开启接收，再粘贴其配对码添加。"
                           Foreground="{StaticResource Muted}" FontSize="14" Margin="0,24,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="PagePlaceholder" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                       FontSize="14" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Card}" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"/>
                                    <TextBlock Text="{Binding Platform}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="远程控制" Foreground="{StaticResource Accent}" Background="Transparent"
                                            BorderThickness="0" Click="Connect_Click" Tag="{Binding Id}"/>
                                    <Button Content="移除" Foreground="{StaticResource Muted}" Background="Transparent"
                                            BorderThickness="0" Click="RemoveDevice_Click" Tag="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 远控视图 -->
        <Grid Grid.Column="1" x:Name="RemoteView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#202226" Padding="8,6" Margin="8,8,8,0" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="显示屏" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="全屏" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4" Click="FullScreen_Click"/>
                    <Button Content="窗口设置" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="画质" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="鼠标" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="键盘" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="文件传输" Foreground="White" Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button Content="断开" Foreground="{StaticResource Accent}" Background="Transparent"
                            BorderThickness="0" Padding="10,4" Click="Disconnect_Click"/>
                </StackPanel>
            </Border>

            <local:RemoteVideoControl x:Name="VideoCanvas" Grid.Row="1" Margin="8"
                                       MouseLeftButtonDown="Video_MouseDown"
                                       MouseLeftButtonUp="Video_MouseUp"
                                       MouseMove="Video_MouseMove"/>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="未连接" Foreground="{StaticResource Muted}"
                       Margin="12,2,12,8" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
